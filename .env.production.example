# Production settings template. Copy to .env.production and fill secrets on the server.
# This file alone does NOT turn compose.yaml into a production configuration.
# A separate production Compose/images/HTTPS setup is still required.
COMPOSE_PROJECT_NAME=hackalem-production
POSTGRES_DB=hackalem_production
POSTGRES_USER=hackalem_production
# Required: set a unique strong password before deployment. No development fallback.
POSTGRES_PASSWORD=
FRONTEND_PORT=8080
API_PORT=7575
# Required only when deploying the Telegram bot.
BOT_TOKEN=

# Required for authentication: random secret of at least 32 bytes, kept server-side.
SECURITY_JWT_SECRET=
SECURITY_TOKEN_TTL_SECONDS=3600

# Ключи моделей. Без них LLM-часть не работает, остальное поднимается.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required only when LLM_PROVIDER=nvidia; use the model ID from NVIDIA API Catalog.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# OpenAI-compatible HTTP APIs (for example, Qwen via Alibaba Cloud Model Studio).
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# Загрузка файлов и доступ из браузера
STORAGE_MAX_UPLOAD_MB=25
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Первый вход. В production задайте собственные значения, дефолтов здесь нет.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MOCK_PASSWORD=
