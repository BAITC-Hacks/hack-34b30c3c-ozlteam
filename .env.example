# Legacy default environment template. Prefer .env.local.example and make dev.
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_dev
FRONTEND_PORT=5173
API_PORT=7575
# Enable with: make dev-bot
BOT_TOKEN=

# Required for authentication: random secret of at least 32 bytes, kept server-side.
SECURITY_JWT_SECRET=
SECURITY_TOKEN_TTL_SECONDS=3600

# Model provider (legacy template; prefer .env.local.example).
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
