# Local Docker development. Copy to .env.local (make dev does this automatically).
COMPOSE_PROJECT_NAME=hackalem
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_dev
FRONTEND_PORT=5173
API_PORT=7575
# Optional: enable with make dev-bot
BOT_TOKEN=

# Generate a random secret of at least 32 bytes before enabling /api/v1/auth.
SECURITY_JWT_SECRET=
SECURITY_TOKEN_TTL_SECONDS=3600

# Ключи моделей. Без них LLM-часть не работает, остальное поднимается.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
# Required only when LLM_PROVIDER=nvidia; use the model ID from NVIDIA API Catalog.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# OpenAI-compatible HTTP APIs (for example, Qwen via Alibaba Cloud Model Studio).
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# Загрузка файлов и доступ из браузера
STORAGE_MAX_UPLOAD_MB=25
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Первый вход. Пароль не короче 12 символов — таково требование DTO пользователя.
# Значения ниже годятся только для локальной разработки.
SEED_ADMIN_EMAIL=admin@hackalem.local
SEED_ADMIN_PASSWORD=admin-local-12345
SEED_MOCK_PASSWORD=demo-local-12345
